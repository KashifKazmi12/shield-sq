generator client {
  provider      = "prisma-client-js"
  // "native" for local dev/Docker; "rhel-openssl-3.0.x" is what Vercel's
  // Node.js serverless functions run on (Amazon Linux 2) — without it,
  // Prisma works locally but throws "query engine not found" in prod on
  // Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  // Platform operator — manages Company tenants, belongs to none itself.
  super_admin
  // Scoped to exactly one Company (via User.companyId).
  admin
  viewer
}

// Product areas a company is entitled to. Set by the super admin at company
// creation (and editable afterward) — gates onboarding wizard content and the
// sidebar, but never blocks the Trivy/Falco ingest webhooks themselves (a
// disabled feature hides the UI, it doesn't stop data collection).
enum CompanyFeature {
  vulnerabilities
  runtime_alerts
  leak_checking
  url_monitoring
}

enum LeakIdentifierType {
  email
  username
}

enum MonitorStatus {
  pending
  active
  disabled
  error
}

enum LeakProvider {
  checkleaked
  leakcheck
}

model Company {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  createdAt    DateTime          @default(now())
  // Set to block login for every user in this company without deleting data.
  suspendedAt  DateTime?
  features     CompanyFeature[]  @default([])
  // The single admin the super admin treats as this company's point of
  // contact — set to the admin created alongside the company, used by
  // resetCompanyAdminPassword so "reset the admin password" always targets
  // one specific person even once a company has several admins (see
  // settings/actions.ts's team management, which allows more than one).
  ownerId      String?           @unique
  owner        User?             @relation("CompanyOwner", fields: [ownerId], references: [id])
  users        User[]            @relation("CompanyUsers")
  projects     Project[]
  monitoredIdentities MonitoredIdentity[]
  monitoredSites      MonitoredSite[]
  leakProviderUsage   LeakProviderUsage[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(viewer)
  // Null only for super_admin — every admin/viewer belongs to one company.
  companyId    String?
  company      Company?  @relation("CompanyUsers", fields: [companyId], references: [id])
  ownerOfCompany Company? @relation("CompanyOwner")
  createdAt    DateTime  @default(now())
  // Set once the first-login setup wizard is completed. Gates the
  // /onboarding redirect for admins; viewers never see the wizard.
  onboardedAt  DateTime?
  createdLeakIdentities MonitoredIdentity[]
  leakProviderUsage     LeakProviderUsage[]
  updatedLeakProviderConfigs LeakProviderConfig[]

  @@index([companyId])
}

model Project {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  name          String
  createdAt     DateTime            @default(now())
  scans         Scan[]
  findings      Finding[]
  tokens        IngestToken[]
  notifyConfig  NotificationConfig?

  @@index([companyId])
}

model IngestToken {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id])
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([projectId])
}

model Scan {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id])
  source         String // "trivy" | "falco"
  repo           String?
  pipelineId     String?
  branch         String?
  commitSha      String?
  status         String // "success" | "failed" | "warning"
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  // Findings whose *first* detection was this scan (Finding.scanId).
  findings       Finding[]
  // Immutable per-run observations — every finding reported in this scan's
  // payload, including CVEs that already existed from earlier runs.
  observations   ScanFinding[]
  rawPayload     Json

  @@index([projectId, source, createdAt])
}

model Finding {
  id            String              @id @default(cuid())
  // First scan that created this finding — never moved when later runs
  // re-report the same CVE (see ScanFinding for per-run history).
  scanId        String
  scan          Scan                @relation(fields: [scanId], references: [id])
  // Denormalized from scan.projectId — exists specifically so dedupeKey's
  // uniqueness below can be scoped per project, not global. Without it, two
  // different projects/companies whose Falco alerts ever produced the same
  // content (e.g. the same fixture posted to two projects in testing) would
  // collide: the second project's ingest would silently report the first
  // project's finding as "already deduped" instead of creating its own.
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id])
  tool          String // "trivy" | "falco"
  severity      String // "critical" | "high" | "medium" | "low" | "info"
  title         String
  description   String?
  resource      String?
  fixedVersion  String?
  ruleName      String?
  detectedAt    DateTime            @default(now())
  // opened | resolved | reopened — Trivy lifecycle (Falco stays opened for now).
  status        String              @default("opened")
  // Periods the finding was actively open. Lifetime = sum of these intervals
  // (resolved gaps do not count). Shape: [{ start: ISO, end: ISO | null }].
  openIntervals Json                @default("[]")
  // Dedupe key scoped to (projectId, dedupeKey) — see the projectId comment
  // above. Falco: alert UUID when present, else a hash of (rule, output,
  // timestamp). Trivy: stable key of (CVE, package, target) so a later CI
  // run that reports the same vuln does not insert a duplicate Finding.
  dedupeKey     String?
  notifications AlertNotification[]
  observations  ScanFinding[]

  @@unique([projectId, dedupeKey])
  @@index([scanId])
  @@index([severity])
  @@index([tool, detectedAt])
  @@index([projectId, tool, status])
}

// Join: this finding was present in this scan's payload. Counts and run/bucket
// detail pages use this table so re-reporting a CVE on a later pipeline does
// not move it off the earlier run.
model ScanFinding {
  id         String   @id @default(cuid())
  scanId     String
  scan       Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findingId  String
  finding    Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  observedAt DateTime @default(now())

  @@unique([scanId, findingId])
  @@index([findingId])
  @@index([scanId])
}

model AlertNotification {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id])
  channel   String // "slack" | "email"
  sentAt    DateTime @default(now())
  status    String // "sent" | "failed"

  @@index([findingId])
}

model NotificationConfig {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  project            Project  @relation(fields: [projectId], references: [id])
  slackWebhookUrl    String?
  notifyEmail        String?
  severityThreshold  String   @default("critical") // minimum severity that triggers a notification
  updatedAt          DateTime @updatedAt
}

// Audit trail for rejected ingestion requests (bad token, malformed body) —
// needed to debug client pipeline misconfigurations without granting log access.
model IngestAuditLog {
  id         String   @id @default(cuid())
  source     String // "trivy" | "falco"
  projectId  String?
  reason     String // e.g. "invalid_token" | "malformed_payload" | "rate_limited"
  detail     String?
  createdAt  DateTime @default(now())

  @@index([source, createdAt])
}

// Audit trail for admin-driven changes within a company (tokens, team,
// notification config, projects) — so "who changed this and when" has an
// answer without needing server log access. Not tied by foreign key to the
// mutated row (a revoked token, a removed teammate) since that row may no
// longer exist by the time anyone reads the log.
model AdminAuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorEmail String
  action     String // e.g. "token.create" | "team.remove" | "notify.update"
  detail     String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
}

// --- Leak Checking ---------------------------------------------------------

// A monitored email/username, company-scoped (not project-scoped — unlike
// Trivy/Falco findings, a leaked credential isn't tied to a codebase/repo).
model MonitoredIdentity {
  id                String              @id @default(cuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id])
  createdById       String?
  createdBy         User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  identifierType    LeakIdentifierType
  identifierValue   String
  status            MonitorStatus       @default(pending)
  checkIntervalMins Int                 @default(1440)
  lastCheckedAt     DateTime?
  nextCheckAt       DateTime?
  lastError         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  findings          LeakFinding[]

  @@unique([companyId, identifierType, identifierValue])
  @@index([nextCheckAt])
}

model LeakFinding {
  id         String            @id @default(cuid())
  identityId String
  identity   MonitoredIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  source     String // "checkleaked" | "leakcheck"
  breachName String
  severity   String            @default("medium") // "low" | "medium" | "high" — see computeSeverity()
  leakedAt   DateTime?
  // sha256(source + breachName + a stable field from the raw entry) — see
  // src/lib/leak-providers.ts. Prevents an unbounded number of duplicate
  // rows when the same identity is re-synced against the same breach.
  dedupeKey  String
  // Raw provider entry, with credential-like fields (password) masked
  // before storage — see maskSecret() in leak-providers.ts. Kept for
  // severity computation/display, never round-trips a cleartext secret.
  details    Json?
  // The real leaked password, encrypted (AES-256-GCM, src/lib/secrets.ts) —
  // null when the provider didn't return one for this entry. Decrypted only
  // by revealFindingPassword, on demand, never included in the findings
  // list payload.
  passwordCiphertext String?
  createdAt  DateTime          @default(now())

  @@unique([identityId, dedupeKey])
  @@index([identityId, source, breachName])
}

// --- URL Monitoring ---------------------------------------------------------

model MonitoredSite {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id])
  url       String
  domain    String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  endpoints MonitoredEndpoint[]
  scans     SiteScanResult[]

  @@unique([companyId, url])
  @@index([companyId, domain])
}

model MonitoredEndpoint {
  id        String           @id @default(cuid())
  siteId    String
  site      MonitoredSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  path      String
  createdAt DateTime         @default(now())
  scans     SiteScanResult[]

  @@unique([siteId, url])
  @@index([siteId])
}

model SiteScanResult {
  id         String             @id @default(cuid())
  siteId     String
  site       MonitoredSite      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  endpointId String?
  endpoint   MonitoredEndpoint? @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  statusCode Int?
  latencyMs  Float?
  scannedAt  DateTime           @default(now())

  @@index([siteId, scannedAt])
  @@index([endpointId, scannedAt])
}

// --- Leak provider configuration (super admin, platform-level) -------------

// One row per provider — holds the encrypted credential and its position in
// the fallback try-order. Super-admin-managed via /configuration, not tied
// to any one company (shared infrastructure across every tenant).
model LeakProviderConfig {
  id               String       @id @default(cuid())
  provider         LeakProvider @unique
  // AES-256-GCM ciphertext (iv + authTag + ciphertext, base64) — see
  // src/lib/secrets.ts. Decrypted only inside leak-providers.ts at call
  // time; never sent to the client.
  apiKeyCiphertext String?
  // Computed once at save time (e.g. "5F09••••••••4626") — the only
  // representation of the key any read of this table ever returns. There is
  // no "reveal full key" path anywhere in the app, by design.
  apiKeyPreview    String?
  priority         Int          @default(1) // lower = tried first; unique across however many providers exist
  enabled          Boolean      @default(true)
  // Simple resettable "calls made since last reset" counter, shown directly
  // on the provider row — separate from LeakProviderUsage (the immutable
  // audit log powering quota enforcement and the Usage dashboard), which is
  // never reset. Incremented alongside every LeakProviderUsage write.
  usageCount       Int          @default(0)
  updatedAt        DateTime     @updatedAt
  updatedById      String?
  updatedBy        User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([priority])
}

// One row = one outbound provider call attempt — powers both the usage
// dashboard and quota enforcement (global/company/user), so the two can
// never drift apart.
model LeakProviderUsage {
  id        String       @id @default(cuid())
  provider  LeakProvider
  companyId String?
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  createdAt DateTime     @default(now())

  @@index([provider, createdAt])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

// Singleton row (id is always "default") holding the three quota knobs — one
// platform-wide policy in v1, not a per-company override table.
model LeakProviderLimits {
  id                   String   @id @default("default")
  globalDailyLimit     Int?
  perCompanyDailyLimit Int?
  perUserDailyLimit    Int?
  updatedAt            DateTime @updatedAt
}
